{
  "name": "even-g2-japanese-large",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5175",
    "sim": "node node_modules/@evenrealities/evenhub-simulator/bin/index.js http://localhost:5175",
    "qr": "evenhub qr",
    "build": "tsc && vite build",
